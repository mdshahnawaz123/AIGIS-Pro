{
  "Application": {
    "Name": "AI GIS Converter",
    "WorkspaceRoot": "%LOCALAPPDATA%\\AiGisConverter",
    "MaxDegreeOfParallelism": 4
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Debug"
      },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%\\AiGisConverter\\logs\\aigis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Database": {
    "ConnectionString": "Data Source=%LOCALAPPDATA%\\AiGisConverter\\aigis.db",
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 60
  },
  "Cad": {
    "Tessellation": {
      "ChordTolerance": 0.01,
      "MinimumSegments": 4,
      "MaximumSegments": 512,
      "SegmentsPerSplineSpan": 16
    },
    "IncludeInvisibleLayers": false,
    "IncludeFrozenLayers": false,
    "ExplodeBlocks": false,
    "MaxBlockNestingDepth": 8,
    "ReadBlockAttributes": true,
    "ReadText": true,
    "ReadHatches": true,
    "ReadDimensions": false,
    "AssumedUnits": "Unknown",
    "ReadCrsSidecar": true,
    "MaxElements": 0
  },
  "Gis": {
    "DefaultProfile": "generic-geojson",
    "ProfileSearchPaths": [
      "Profiles",
      "%LOCALAPPDATA%\\AiGisConverter\\Profiles"
    ],
    "Geometry": {
      "ChordTolerance": 0.01,
      "VertexTolerance": 1e-08,
      "MinimumLineLength": 1e-06,
      "MinimumPolygonArea": 1e-09,
      "PrecisionScale": 0,
      "RepairInvalidGeometry": true,
      "DropIrreparableGeometry": false,
      "NormaliseRingOrientation": true,
      "SimplificationTolerance": 0
    },
    "Streaming": {
      "FlushInterval": 5000,
      "ProgressInterval": 10000,
      "BufferSize": 262144,
      "ValidationBatchSize": 1000,
      "MaxDegreeOfParallelism": 0,
      "MaxConsecutiveFailures": 1000
    },
    "Crs": {
      "ProjDataPath": "",
      "GdalDataPath": "",
      "CacheTransformations": true,
      "UseAuthorityAxisOrder": false
    }
  },
  "Ai": {
    "ActiveProvider": "rulebased",
    "FallbackProvider": "rulebased",
    "ConfidenceThreshold": 0.65,
    "EnableCaching": true,
    "CacheTimeToLiveMinutes": 240,
    "ProbeBeforeUse": true,
    "Resilience": {
      "MaxRetries": 2,
      "BaseDelayMilliseconds": 500,
      "PerAttemptTimeoutSeconds": 120
    },
    "Providers": {
      "rulebased": {
        "KeywordConfidence": 0.8,
        "MaximumSimilarityConfidence": 0.7,
        "MinimumScore": 0.25,
        "KeywordRules": {},
        "Abbreviations": {}
      },
      "ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "llama3.1",
        "Temperature": 0.0,
        "TimeoutSeconds": 120,
        "MaxSubjectsPerCall": 20,
        "KeepAlive": "5m",
        "UseJsonFormat": true
      },
      "openai": {
        "Endpoint": "https://api.openai.com/v1/",
        "Model": "gpt-4o-mini",
        "Temperature": 0.0,
        "TimeoutSeconds": 120,
        "MaxSubjectsPerCall": 25,
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "Organization": null,
        "Project": null,
        "UseJsonResponseFormat": true
      },
      "onnx": {
        "ModelPath": "assets/models/onnx/layer-classifier.onnx",
        "LabelsPath": "assets/models/onnx/labels.json",
        "InputTensorName": "",
        "OutputTensorName": "",
        "FeatureDimension": 512,
        "IntraOpNumThreads": 2,
        "ApplySoftmax": true
      }
    }
  },
  "QaQc": {
    "FailAtOrAbove": "Critical",
    "DisabledRules": [],
    "MaximumFindingsPerRule": 500,
    "TopologyFeatureCeiling": 250000,
    "Topology": {
      "CheckOverlaps": true,
      "CheckDangles": true,
      "CheckSlivers": true,
      "MinimumOverlapArea": 1e-06,
      "DangleTolerance": 0.001,
      "SliverThinnessRatio": 0.01,
      "SliverMaximumArea": 10.0
    },
    "Attributes": {
      "RequiredFields": [],
      "UniqueFields": [],
      "MaximumFieldNameLength": 10,
      "MaximumTextLength": 254,
      "SparseFieldThreshold": 0.95
    },
    "Reporting": {
      "Formats": [
        "html",
        "csv",
        "json"
      ],
      "MinimumSeverity": "Information",
      "GroupByRule": true
    }
  },
  "Export": {
    "OutputDirectory": "%USERPROFILE%\\Documents\\AiGisConverter\\Output",
    "Formats": [
      "GeoJson"
    ],
    "OverwriteExisting": false,
    "Shapefile": {
      "Encoding": "UTF-8",
      "WritePrjFile": true
    },
    "GeoJson": {
      "Indented": false,
      "CoordinatePrecision": 7
    },
    "GeoPackage": {
      "LayerNamingStrategy": "CadLayer"
    },
    "Csv": {
      "Delimiter": ",",
      "IncludeWktGeometry": true
    },
    "Kml": {
      "AltitudeMode": "clampToGround"
    }
  },
  "Batch": {
    "MaxConcurrentFiles": 2,
    "ContinueOnFileError": true,
    "WriteManifest": true
  },
  "Plugins": {
    "SearchPaths": [
      "Plugins",
      "%LOCALAPPDATA%\\AiGisConverter\\Plugins"
    ],
    "Enabled": [],
    "Disabled": [],
    "FailFastOnLoadError": false,
    "LoadTimeoutSeconds": 60,
    "aigis.export.gis": {},
    "aigis.reader.autocad": {
      "pipeName": "AiGisConverter.Bridge.AutoCAD"
    },
    "aigis.reader.revit": {
      "pipeName": "AiGisConverter.Bridge.Revit"
    },
    "aigis.ai.providers": {
      "endpoints": [
        {
          "key": "lmstudio",
          "displayName": "LM Studio (local)",
          "baseAddress": "http://localhost:1234/v1/",
          "model": "qwen2.5-7b-instruct",
          "apiKeyEnvironmentVariable": null,
          "temperature": 0.0,
          "maxSubjectsPerCall": 20,
          "requiresNetwork": false
        },
        {
          "key": "azure-openai",
          "displayName": "Azure OpenAI",
          "baseAddress": "https://<resource>.openai.azure.com/openai/deployments/<deployment>/",
          "model": "gpt-4o-mini",
          "apiKeyEnvironmentVariable": "AZURE_OPENAI_API_KEY",
          "authenticationHeader": "api-key",
          "authenticationScheme": "",
          "temperature": 0.0,
          "requiresNetwork": true
        }
      ]
    }
  }
}
