<UserControl x:Class="AiGisConverter.Presentation.Views.Pages.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Plugins" Style="{StaticResource HeadingStyle}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource CaptionStyle}"
                   Margin="0,0,0,12" />

        <ListView ItemsSource="{Binding Plugins}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Version" Width="70" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="State" Width="100" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="Capabilities" Width="170"
                                    DisplayMemberBinding="{Binding Capabilities}" />
                    <GridViewColumn Header="Needs" Width="90" DisplayMemberBinding="{Binding RequiresHost}" />
                    <!-- Rejected and failed plugins are listed too: one that silently does not
                         appear is the hardest kind of problem to diagnose. -->
                    <GridViewColumn Header="Detail" Width="430" DisplayMemberBinding="{Binding Detail}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
