<UserControl x:Class="AiGisConverter.Presentation.Views.Pages.QaQcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AiGisConverter.Presentation.Converters">
    <UserControl.Resources>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Quality" Style="{StaticResource HeadingStyle}" />

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Show at or above" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="140" ItemsSource="{Binding Severities}"
                              SelectedItem="{Binding MinimumSeverity}" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource CaptionStyle}"
                   Margin="0,0,0,12" />

        <ListView ItemsSource="{Binding Findings}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Severity" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Colour is the secondary cue; the text always says the severity. -->
                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Code" Width="180" DisplayMemberBinding="{Binding Code}" />
                    <GridViewColumn Header="Layer" Width="120" DisplayMemberBinding="{Binding Layer}" />
                    <GridViewColumn Header="Feature" Width="90" DisplayMemberBinding="{Binding FeatureId}" />
                    <GridViewColumn Header="Message" Width="420" DisplayMemberBinding="{Binding Message}" />
                    <GridViewColumn Header="Remediation" Width="320" DisplayMemberBinding="{Binding Remediation}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
