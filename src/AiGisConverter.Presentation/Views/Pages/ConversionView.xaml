<UserControl x:Class="AiGisConverter.Presentation.Views.Pages.ConversionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Convert" Style="{StaticResource HeadingStyle}" />

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button DockPanel.Dock="Right" Content="Start" Command="{Binding StartCommand}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Concurrent drawings" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="48" Text="{Binding MaxConcurrency}" />
                        <CheckBox Content="Continue on error" Margin="16,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding ContinueOnError}" />
                    </StackPanel>
                </DockPanel>

                <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="False" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Status}" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Completed" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding Runs}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Status" Width="150"
                                                DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Features" Width="90"
                                                DisplayMemberBinding="{Binding FeaturesWritten, StringFormat=N0}" />
                                <GridViewColumn Header="Findings" Width="90"
                                                DisplayMemberBinding="{Binding IssueCount, StringFormat=N0}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Failed" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Failures}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
