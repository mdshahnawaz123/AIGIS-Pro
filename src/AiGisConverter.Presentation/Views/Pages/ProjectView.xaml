<UserControl x:Class="AiGisConverter.Presentation.Views.Pages.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Searchable CRS picker, reused for both the Input and Output coordinate systems.
             DataContext is a CrsSelectorViewModel. -->
        <DataTemplate x:Key="CrsSelectorTemplate">
            <StackPanel>
                <Border Background="#11000000" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Selected:  " Opacity="0.7" />
                        <Button DockPanel.Dock="Right" Content="★" MinWidth="28" Padding="4,0"
                                Command="{Binding ToggleFavouriteCommand}"
                                ToolTip="Add or remove from favourites" />
                        <TextBlock Text="{Binding SelectedIdentifier}" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <!-- Quick picks: favourites and recently used, so the common case is one click. -->
                <ItemsControl ItemsSource="{Binding Favourites}" Margin="0,0,0,2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Opacity="0.85">
                                <Run Text="★ " />
                                <Run Text="{Binding Identifier, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" " />
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Recent}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="⟳ " />
                                <Run Text="{Binding Identifier, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding DetectionMessage}" TextWrapping="Wrap" FontSize="11"
                           Foreground="#0A6" Margin="0,0,0,4" />

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by EPSG code, name, country, city, region, UTM zone or datum" />

                <TextBlock Text="Searching..." Opacity="0.6" Margin="2,3,0,0"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />

                <!-- CRS information panel: shown once a system is selected. -->
                <Border Background="#0D000000" CornerRadius="3" Padding="8,6" Margin="0,4,0,0"
                        Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedInfo.Epsg}" FontWeight="SemiBold" />
                            <TextBlock Text="  " />
                            <TextBlock Text="{Binding SelectedInfo.Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SelectedInfo.Type, StringFormat=Type: {0}}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding SelectedInfo.Units, StringFormat=Units: {0}}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding SelectedInfo.Projection, StringFormat=Projection: {0}}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding SelectedInfo.Datum, StringFormat=Datum: {0}}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedInfo.AxisOrder, StringFormat=Axis: {0}}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding SelectedInfo.UtmZone, StringFormat=UTM zone: {0}}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding SelectedInfo.CentralMeridian, StringFormat=Central meridian: {0}}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding SelectedInfo.AreaOfUse, StringFormat=Area: {0}}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Results}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         MaxHeight="180" Margin="0,4,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Identifier}" FontWeight="SemiBold" />
                                    <TextBlock Text="  " />
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding AreaName}" Opacity="0.6" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Opacity="0.5">
                                    <TextBlock Text="{Binding Datum}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="  ·  " FontSize="10" />
                                    <TextBlock Text="{Binding ProjectionMethod}" FontSize="10" />
                                    <TextBlock Text="  ·  " FontSize="10" />
                                    <TextBlock Text="{Binding Units}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Project" Style="{StaticResource HeadingStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource CaptionStyle}" />
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Input coordinate system: the drawing's own CRS (Auto-detect by default). -->
                    <TextBlock Text="Input coordinate system" Style="{StaticResource CaptionStyle}" />
                    <ContentControl Content="{Binding InputCrsSelector}" ContentTemplate="{StaticResource CrsSelectorTemplate}" />

                    <!-- Output coordinate system: the CRS to convert into. -->
                    <TextBlock Text="Output coordinate system" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" />
                    <ContentControl Content="{Binding OutputCrsSelector}" ContentTemplate="{StaticResource CrsSelectorTemplate}" />

                    <!-- Pass-through: shown when the machine cannot reproject, so the operator is
                         never surprised by output that is still in the source system. -->
                    <Border Background="#22E0A030" BorderBrush="#E0A030" BorderThickness="1" CornerRadius="3"
                            Padding="8,6" Margin="0,10,0,0"
                            Visibility="{Binding IsPassThrough, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Pass-through mode: coordinate transformation is unavailable on this machine, so features will be written in the input coordinate system without reprojection." />
                    </Border>

                    <!-- Pre-conversion coordinate-system checks. Errors block Convert. -->
                    <Border Background="#0D000000" CornerRadius="3" Padding="8,6" Margin="0,10,0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding ValidationFindings}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Re-check" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"
                                    Command="{Binding ValidateCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Export format" Style="{StaticResource CaptionStyle}" />
                    <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding ExportFormat}" />

                    <TextBlock Text="Classification confidence threshold" Style="{StaticResource CaptionStyle}" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Width="48"
                                   Text="{Binding ConfidenceThreshold, StringFormat={}{0:P0}}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding ConfidenceThreshold}" />
                    </DockPanel>

                    <TextBlock Text="Output folder" Style="{StaticResource CaptionStyle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..."
                                Command="{Binding ChooseOutputFolderCommand}" />
                        <TextBox Text="{Binding OutputFolder}" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Add drawings..."
                                Command="{Binding AddDrawingsCommand}" />

                        <!--
                            One button per loaded bridge plugin. Hidden entirely when none is
                            loaded, so an operator without Revit or AutoCAD is not offered a
                            control that could only ever fail.
                        -->
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding LiveSessions}"
                                      Visibility="{Binding HasLiveSessions,
                                                   Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,0"
                                            Content="{Binding Caption}"
                                            ToolTip="{Binding ReaderName}"
                                            Command="{Binding DataContext.AddLiveSessionCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Drawings" FontWeight="SemiBold" />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding Drawings}" MinHeight="180" MaxHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" MinWidth="72" Padding="6,2"
                                            Command="{Binding DataContext.RemoveDrawingCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionStyle}"
                               Text="{Binding SupportedExtensionsText, StringFormat=Readable formats: {0}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
