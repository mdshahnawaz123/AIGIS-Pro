<Project Sdk="Microsoft.NET.Sdk">

  <!-- Layer: GIS. NetTopologySuite geometry, PROJ/ProjNet reprojection, GDAL/OGR export. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AiGisConverter.Gis</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiGisConverter.Domain\AiGisConverter.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" />
    <PackageReference Include="ProjNet" />
    <PackageReference Include="MaxRev.Gdal.Core" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- Native GDAL/PROJ binaries are Windows x64 only. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="MaxRev.Gdal.WindowsRuntime.Minimal" />
  </ItemGroup>

  <!-- Built-in profiles ship inside the assembly so a default install needs no data files;
       a user file of the same id in a search path replaces one at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Profiles\BuiltIn\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
