<Project>

  <!-- Inherit solution-wide settings, then apply plugin-project defaults. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPluginProject>true</IsPluginProject>
    <!-- Each plugin publishes into its own folder; the host scans one level down. -->
    <PluginStagingRoot>$(MSBuildThisFileDirectory)..\artifacts\plugins\</PluginStagingRoot>
  </PropertyGroup>

  <!--
    The plugin.json copy rule is deliberately NOT here. Directory.Build.props is imported before
    the SDK defines its default None glob, so an Update against those items is a silent no-op and
    the manifest never reaches bin. It lives in Directory.Build.targets instead, which is imported
    after the default items exist.
  -->

</Project>
