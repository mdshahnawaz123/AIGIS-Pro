<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AiGisConverter.Plugins.Ifc</RootNamespace>
    <AssemblyName>AiGisConverter.Plugins.Ifc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reader is internal to the plugin; the verification tests drive it directly rather
         than only through the plugin host, so the IFC parsing can be asserted in isolation. -->
    <InternalsVisibleTo Include="AiGisConverter.Plugins.Ifc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Third-party format library. Unlike the contract references below it is copied into the
         plugin folder (default Private=true): each plugin owns its own backend. -->
    <PackageReference Include="Xbim.Essentials" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Contract assemblies are resolved from the host's load context, never from the plugin folder.
      Private=false stops them being copied here: a second copy would be either dead weight or,
      if the host's shared-assembly list were ever wrong, a second Type identity - after which
      every cast across the plugin boundary fails with an error that reads like a type cannot be
      converted to itself.
    -->
    <ProjectReference Include="..\..\src\AiGisConverter.Domain\AiGisConverter.Domain.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\AiGisConverter.Plugins.Abstractions\AiGisConverter.Plugins.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
