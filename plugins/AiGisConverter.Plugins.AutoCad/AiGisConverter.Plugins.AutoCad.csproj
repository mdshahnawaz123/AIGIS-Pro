<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-bound plugin. The AutoCAD API only functions inside AutoCAD's own process, so this
    assembly is the bridge client; the code touching the vendor API is an add-in installed
    into AutoCAD itself (see addins/).
  -->
  <PropertyGroup>
    <RootNamespace>AiGisConverter.Plugins.AutoCad</RootNamespace>
    <AssemblyName>AiGisConverter.Plugins.AutoCad</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Contract assemblies are resolved from the host's load context, never from the plugin folder.
      Private=false stops them being copied here: a second copy would be either dead weight or,
      if the host's shared-assembly list were ever wrong, a second Type identity - after which
      every cast across the plugin boundary fails with an error that reads like a type cannot be
      converted to itself.
    -->
    <ProjectReference Include="..\..\src\AiGisConverter.Domain\AiGisConverter.Domain.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\AiGisConverter.Plugins.Abstractions\AiGisConverter.Plugins.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!--
      Bridge.Client is NOT a contract assembly and is deliberately copied here, unlike the two
      above. Nothing of its own crosses the plugin boundary: the reader it provides is handed to
      the host as IDataSourceReader, which lives in Abstractions. Because it is absent from
      PluginOptions.SharedAssemblies, the load context resolves it from this plugin's own
      dependencies - so it has to be in this folder. Marked Private=false it was in neither the
      plugin folder nor beside the host, and the plugin could not load at all.
    -->
    <ProjectReference Include="..\..\src\AiGisConverter.Bridge.Client\AiGisConverter.Bridge.Client.csproj" />
    <ProjectReference Include="..\..\src\AiGisConverter.Bridge.Protocol\AiGisConverter.Bridge.Protocol.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
