<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demonstrates that an AI provider can be added entirely from outside the AI layer.
    Nothing in AiGisConverter.Ai was modified to make this plugin selectable.
  -->
  <PropertyGroup>
    <RootNamespace>AiGisConverter.Plugins.AiProviders</RootNamespace>
    <AssemblyName>AiGisConverter.Plugins.AiProviders</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Contract assemblies are resolved from the host's load context, never from the plugin folder.
      Private=false stops them being copied here: a second copy would be either dead weight or,
      if the host's shared-assembly list were ever wrong, a second Type identity - after which
      every cast across the plugin boundary fails with an error that reads like a type cannot be
      converted to itself.
    -->
    <ProjectReference Include="..\..\src\AiGisConverter.Domain\AiGisConverter.Domain.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\AiGisConverter.Ai\AiGisConverter.Ai.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\AiGisConverter.Plugins.Abstractions\AiGisConverter.Plugins.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
